# deploy.sh settings for the university k0s cluster, rendered by
# hack/gitops/render.sh into ./generated (synced by Flux). No secrets here:
# they are created once with hack/gitops/secrets.sh.
IMG_REGISTRY=docker.io/jjhonson
# CI overrides IMG_TAG with the commit it built (sha-<7>).
IMG_TAG=sha-5c002d1
# No NetBird on k0s: gateways are reached as in-cluster services.
MESH_ENFORCE=false
# The demo/live UI (frontend/), read-only: kubectl -n mcp-eval-ui port-forward svc/mcp-eval-ui 8787:80
DEPLOY_UI=1
# The LLM runs on the GPU PC, served by API over ZeroTier: hack/pc-services/pc up
# (llama.cpp, Gemma, 64K context, no thinking; settings in pc.conf.example).
# Gemma 4 12B takes ~11 GB of the 16 GB VRAM at 64K context (LFM2.5-24B took
# ~15 GB at 32K and starved everything else on the GPU). The agents are told
# 56K, not 64K: OpenCode under-counts tokens, and evaluator prompts reach ~46K.
LLM_PROVIDER=local
LOCAL_LLM_URL=http://10.147.17.21:8080/v1
LLM_MODEL=gemma-4-12b-it
LLM_CONTEXT_TOKENS=56000
# Vigil runs on the GPU PC too (hack/pc-services/pc up), behind a token
# check; the cluster keeps a relay with the same Service (manifests/vigil-remote.yaml).
# The PC is not a cluster node any more (hack/gpu-node is archived).
VIGIL_REMOTE_URL=http://10.147.17.21:5000
# Occludra also scans every completion with Vigil, both ways: prompts before
# they reach the LLM (a detection answers 403 vigil_block) and responses after
# (log + metric only). It ran live since 2026-11-10 by `kubectl set env`; it
# lives here so Flux keeps it. The PC's Vigil scans on CPU, hence the timeout.
# To stop blocking and only record: VIGIL_IN_ACTION=log.
VIGIL_SCAN_IN=1
VIGIL_SCAN_OUT=1
VIGIL_IN_ACTION=block
VIGIL_TIMEOUT_MS=90000
CHROMA_QUERY_REPLICAS=1
# Compaction off: the 3.9 GB workers cannot hold it next to the query node
# (2026-10-28); the loaded corpus is read from the log as it is.
CHROMA_COMPACTION_REPLICAS=0
# Built locally from the git-ignored corpus file (hack/vigil-corpus), pushed once.
VIGIL_CORPUS_IMG=docker.io/jjhonson/vigil-corpus:e5s-v3-2d9653151abc
# kubectl get endpointslices -n default -l kubernetes.io/service-name=kubernetes
RENDER_API_PEERS=10.66.50.59
RENDER_API_PORT=6443
# One fixed entry point: MetalLB (L2) announces this range on the MD network
# (OpenStack subnet MD_ingress); Traefik takes the first address and serves
# the UI at https://10.66.51.11/ behind basic auth (hack/gitops/secrets.sh).
DEPLOY_INGRESS=1
INGRESS_IP_RANGE=10.66.51.11-10.66.51.20
